<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.juno.cs-quality-timeline-checks</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Library/Developer/CommandLineTools/usr/bin/python3</string>
    <string>/Users/joannejeffries/Documents/GitHub/cs-scripts/quality_timeline_checks.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/joannejeffries/Documents/GitHub/cs-scripts</string>

  <!-- Thursday 18:30 — end of the Fri→Thu reward week, after the 9–18
       shifts finish, so the week's actuals + activity are complete.
       macOS launchd reruns a missed event on next wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>4</integer>
    <key>Hour</key><integer>18</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <!-- Single-shot — exit after the run. launchd reschedules for next Thu. -->
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/joannejeffries/.claude/scheduled-tasks/quality-timeline/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/joannejeffries/.claude/scheduled-tasks/quality-timeline/launchd.err.log</string>
</dict>
</plist>
