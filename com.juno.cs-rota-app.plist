<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.juno.cs-rota-app</string>

  <!-- Streamlit serves on http://localhost:8501. Headless mode = don't try
       to open a browser; we want it running silently in the background. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Developer/CommandLineTools/usr/bin/python3</string>
    <string>-m</string>
    <string>streamlit</string>
    <string>run</string>
    <string>/Users/joannejeffries/Documents/GitHub/cs-scripts/rota_app.py</string>
    <string>--server.port</string>
    <string>8501</string>
    <string>--server.headless</string>
    <string>true</string>
    <!-- Prevent Streamlit from prompting for usage stats on first run -->
    <string>--browser.gatherUsageStats</string>
    <string>false</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/joannejeffries/Documents/GitHub/cs-scripts</string>

  <!-- Auto-start at login and restart on crash so http://localhost:8501
       just works without Jo having to do anything. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Throttle restarts to once every 30 s if it keeps failing -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- Capture launchd-level errors. Streamlit's own logs go to the same
       files since we don't reconfigure logging from the app side. -->
  <key>StandardOutPath</key>
  <string>/Users/joannejeffries/.claude/scheduled-tasks/rota-app/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/joannejeffries/.claude/scheduled-tasks/rota-app/launchd.err.log</string>
</dict>
</plist>
