<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.juno.cs-role-change-daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/joannejeffries/.pyenv/shims/python3</string>
    <string>/Users/joannejeffries/Documents/GitHub/cs-scripts/role_change_daemon.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/joannejeffries/Documents/GitHub/cs-scripts</string>

  <!-- Auto-start at login and restart on crash -->
