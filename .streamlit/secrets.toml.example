# Template for the Streamlit Cloud Secrets pane.
# DO NOT commit a real `secrets.toml` with these values filled in — paste
# them into the Streamlit Cloud app's Settings → Secrets UI instead.
#
# Local dev: the apps will read your existing files under
#   ~/.config/juno/claude-code/
# so you don't need a local secrets.toml unless you want to override the
# default password.

# Shared password for all 4 apps. All TLs get the same password.
APP_PASSWORD = "set-a-strong-password-in-the-cloud-ui"

# Slack bot/user token (xoxp-... or xoxb-...). Current local source:
#   ~/.config/juno/claude-code/slack-token
SLACK_TOKEN = "xoxp-..."

# Looker / Juno staff Postgres connection string. Current local source:
#   STAFF_APP_LOOKER_POSTGRES_URL env var
LOOKER_POSTGRES_URL = "postgres://user:pass@host:port/dbname"

# Google OAuth user credentials with refresh token. Paste the JSON
# CONTENT of ~/.config/juno/claude-code/google-credentials.json as a
# multi-line string between triple quotes. Includes refresh_token and
# auto-renews access tokens without browser interaction.
GOOGLE_SERVICE_ACCOUNT = """
{
  "client_id": "...",
  "client_secret": "...",
  "refresh_token": "...",
  "token_uri": "https://oauth2.googleapis.com/token",
  "type": "authorized_user"
}
"""
